# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Get your ID from @userinfobot
TELEGRAM_ALLOWED_USERS=123456789

# Secret key for SMS webhook API (use a long random string)
API_SECRET_KEY=change-this-to-a-long-random-secret

# Apna database yahan daalo (pick one):
# SQLite (default, local file)
DATABASE_URL=sqlite:///./sms_monitor.db

# MySQL example
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sms_monitor

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sms_monitor

# Server port
PORT=8000

# Firebase HTTP workers (keep low on small VPS — 8–16)
FIREBASE_WORKERS=16

# Virtus APK central config DB (for KEY-XXXX license keys)
VIRTUS_MODULE_DB=https://virtus-module-default-rtdb.firebaseio.com

# Bot public URL — APK auto-pulls config from {URL}/api/apk-config/{KEY}
PUBLIC_BASE_URL=https://your-vps-domain.com
# VIRTUS_BOT_URL=https://override-if-different.com
