# Copy → .env.panel_search (PC / VPS). Never commit real tokens.
PANEL_SEARCH_BOT_TOKEN=
PANEL_SEARCH_OWNER_IDS=8674644868
PANEL_SEARCH_AUTH_KEY=astik
PANEL_SEARCH_DATABASE_URL=sqlite:///./panel_search.db

# Speed / scan (defaults match Astik-style both+cache)
PANEL_SEARCH_CONCURRENCY=256
PANEL_SEARCH_MAX_WORKERS=256
PANEL_SEARCH_FETCH_TIMEOUT=2.2
PANEL_SEARCH_PER_DB_TIMEOUT=5
PANEL_SEARCH_SKIP_LIVE_IF_CACHED=true
PANEL_SEARCH_BOTH_SKIP_UNCACHED_LIVE=true
PANEL_SEARCH_VARIANT_LIMIT=2
PANEL_SEARCH_PARALLEL_SUBPATHS=6
