# Telegram bot from @BotFather
AADHAAR_BOT_TOKEN=

# Comma-separated Telegram user IDs (owners)
AADHAAR_OWNER_IDS=

# uidai = built-in MyAadhaar bridge (tathya.uidai.gov.in) | remote = your VPS URL
AADHAAR_PROVIDER=uidai
AADHAAR_MOCK_MODE=false

# Optional if using remote bridge only:
AADHAAR_BACKEND_URL=
AADHAAR_BACKEND_KEY=

# UIDAI live (India VPS required — cloud agent often blocked)
UIDAI_TATHYA_BASE=https://tathya.uidai.gov.in
UIDAI_BRIDGE_PORT=8790
UIDAI_CAPTCHA_SOLVER=ddddocr
# UIDAI_CAPTCHA_SOLVER=2captcha
# UIDAI_2CAPTCHA_KEY=
