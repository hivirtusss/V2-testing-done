<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/virtus_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Package card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/package_label"
                android:textColor="@color/virtus_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/packageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/virtus_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Android ID card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/android_id"
                        android:textColor="@color/virtus_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/android_id_hint"
                        android:textColor="@color/virtus_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/androidIdInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="0000000000000000"
                    android:inputType="textNoSuggestions"
                    android:maxLength="16"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/virtus_text"
                    android:textColorHint="@color/virtus_text_dim"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnRefreshId"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_grey"
                    android:contentDescription="@string/android_id"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_red"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/virtus_text"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Data Management header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/data_management"
            android:textColor="@color/virtus_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Reset card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_data"
                android:textColor="@color/virtus_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/reset_data_hint"
                android:textColor="@color/virtus_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnResetData"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_red"
                android:text="@string/reset_data"
                android:textAllCaps="false"
                android:textColor="@color/virtus_text" />
        </LinearLayout>

        <!-- Backups card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backups"
                android:textColor="@color/virtus_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/backupNoteInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/backup_note_hint"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/virtus_text"
                android:textColorHint="@color/virtus_text_dim"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCreateBackup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_red"
                android:text="@string/create_backup"
                android:textAllCaps="false"
                android:textColor="@color/virtus_text"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/backupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
