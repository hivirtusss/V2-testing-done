<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d10"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/backupPkgLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select app from Apps tab"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/backupNoteInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#161018"
        android:hint="Backup note (optional)"
        android:padding="12dp"
        android:textColor="#ffffff"
        android:textColorHint="#555555" />

    <Button
        android:id="@+id/btnCreateBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#c62828"
        android:text="@string/create_backup" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Backup includes APK + data (MT Manager compatible)"
        android:textColor="#666666"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/backupList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
