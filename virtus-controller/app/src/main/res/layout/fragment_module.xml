<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/moduleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/modulePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#888888"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="How APK + ZIP work together:\n\n1. Install Virtus Zygisk module (ZIP)\n2. Install this Controller APK\n3. Select apps in module WebUI → reboot\n4. Set Device ID / Signature here → Save\n5. Open target app → ZIP injects bubble + applies identity\n6. Backups stored in module folder (unlimited)"
            android:textColor="#aaaaaa"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRefreshModule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#760000"
            android:text="Refresh module status" />

        <Button
            android:id="@+id/btnOpenWebUi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#333333"
            android:text="Open Module WebUI (app picker)" />
    </LinearLayout>
</ScrollView>
